# ---------------------------------------------------------------------------
# ReviveAI environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection (SQLAlchemy URL).
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/reviveai

# Maintenance connection used only by scripts/init_db.py to CREATE DATABASE.
# Points at the default 'postgres' database on the same server.
ADMIN_DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/postgres

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where trained model artifacts are written/read.
ARTIFACT_DIR=artifacts

# Synthetic data generation
SEED=42
N_CUSTOMERS=8000
N_PRODUCTS=600
N_CHECKOUT_SESSIONS=100000
N_REVIEWS=50000

# Business economics defaults (INR). Used by the profit optimizer as
# fallbacks when a request does not override them.
GROSS_MARGIN=0.35
EMAIL_COST=0.5
SMS_COST=0.25
WHATSAPP_COST=0.35
CALL_COST=18.0
MANUAL_REVIEW_COST=45.0
